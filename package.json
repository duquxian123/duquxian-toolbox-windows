{
  "name": "duquxian-toolbox-windows",
  "version": "1.1.1",
  "private": true,
  "description": "本地优先的 Windows 个人截图与工具箱应用",
  "main": "./out/main/index.js",
  "author": {
    "name": "duquxian123",
    "email": "34875503+duquxian123@users.noreply.github.com"
  },
  "scripts": {
    "predev": "node scripts/build-plugins.mjs",
    "dev": "electron-vite dev",
    "prestart": "node scripts/build-plugins.mjs",
    "start": "electron-vite preview",
    "prebuild": "node scripts/build-plugins.mjs",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:plugin-isolation": "node scripts/test-plugin-isolation.mjs",
    "prepackage": "node scripts/build-plugins.mjs",
    "package:dir": "npm run build && electron-builder --dir --win --x64 && node scripts/apply-exe-icon.mjs",
    "package": "npm run build && electron-builder --win portable --x64"
  },
  "dependencies": {
    "exifr": "^7.1.3",
    "koffi": "3.3.8",
    "node-hid": "3.3.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "45.3.3",
    "electron-builder": "25.1.8",
    "electron-vite": "6.0.0",
    "rcedit": "5.0.2",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "4.1.12"
  },
  "build": {
    "appId": "com.duquxian.toolbox",
    "productName": "独去闲工具箱",
    "electronDist": "node_modules/electron/dist",
    "npmRebuild": false,
    "asar": true,
    "asarUnpack": [
      "node_modules/koffi/**/*",
      "node_modules/node-hid/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*",
      "resources/**/*",
      "node_modules/koffi/**/*",
      "node_modules/node-hid/**/*",
      "THIRD_PARTY_NOTICES.md",
      "licenses/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "src/plugins",
        "to": "plugins",
        "filter": [
          "*/resources/**"
        ]
      }
    ],
    "win": {
      "signAndEditExecutable": false,
      "artifactName": "独去闲工具箱-${version}-${arch}.${ext}",
      "target": [
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "resources/icon.ico"
    }
  }
}
