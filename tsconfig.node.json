{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "electron-vite/node",
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "@shared/*": [
        "src/shared/*"
      ],
      "@plugins/*": [
        "src/plugins/*"
      ]
    }
  },
  "include": [
    "electron.vite.config.ts",
    "src/main/**/*.ts",
    "src/preload/**/*.ts",
    "src/shared/**/*.ts",
    "src/plugins/*/plugin.ts",
    "src/plugins/*/main/**/*.ts",
    "src/plugins/*/preload/**/*.ts",
    "src/plugins/*/shared/**/*.ts",
    "src/plugins/*/tests/**/*.ts",
    "src/renderer/src/env.d.ts",
    "tests/**/*.ts"
  ]
}

